FROM golang:1.26.3 AS builder

ENV CGO_ENABLED=0
ARG BUILDVCS=false
WORKDIR /src
COPY . .
RUN go build -buildvcs=${BUILDVCS} -ldflags "-s -w" -o /out/fmp ./cmd/fmp && \
    go build -buildvcs=${BUILDVCS} -ldflags "-s -w" -o /out/gitops-preview ./cmd/gitops-preview && \
    go build -buildvcs=${BUILDVCS} -ldflags "-s -w" -o /out/gitops-preview-flux ./cmd/gitops-preview-flux && \
    go build -buildvcs=${BUILDVCS} -ldflags "-s -w" -o /out/gitops-preview-crossplane ./cmd/gitops-preview-crossplane

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && \
    rm -rf /var/lib/apt/lists/*
COPY --from=builder /out/ /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/gitops-preview", "github-action"]
